{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*:*" }, { "url": "http://*:*" }]
    },
    "sql:default",
    "sql:allow-execute",
    "store:default",
    "clipboard-manager:allow-write-text",
    "notification:default",
    "log:default",
    "dialog:default",
    "fs:default"
  ]
}
